--========================================================--
-- GET BOOTH OWNER
--========================================================--

local function getBoothOwnerFromSurfaceGui(
    booth
)

    for _, d in ipairs(
        booth:GetDescendants()
    ) do

        if d:IsA("SurfaceGui") then

            for _, g in ipairs(
                d:GetDescendants()
            ) do

                if g:IsA("TextLabel") then

                    local txt =
                        g.Text


                    if txt
                    and txt ~= "" then

                        local lower =
                            txt:lower()


                        if lower:find("claim")
                        or lower:find("rent")
                        or lower:find("empty")
                        or lower:find("buy")
                        or lower:find("open") then

                            continue

                        end


                        if #txt >= 3
                        and #txt <= 20 then

                            return txt

                        end

                    end

                end

            end

        end

    end


    return "Unclaimed"

end


--========================================================--
-- WAIT CLAIM
--========================================================--

local function waitForClaim(
    booth,
    timeout
)

    local elapsed = 0


    while elapsed < timeout do

        local owner =
            getBoothOwnerFromSurfaceGui(
                booth
            )


        if owner ~= "Unclaimed" then

            return true

        end


        task.wait(0.5)

        elapsed += 0.5

    end


    return false

end


--========================================================--
-- FIND EMPTY BOOTH
--========================================================--

local function getValidBooth()

    local tradeWorld =
        workspace:WaitForChild(
            "TradeWorld"
        )


    local booths =
        tradeWorld:WaitForChild(
            "Booths"
        )


    for _, booth in ipairs(
        booths:GetChildren()
    ) do

        local success, position =
            pcall(function()

                return booth:GetPivot().Position

            end)


        if success
        and position then

            local owner =
                getBoothOwnerFromSurfaceGui(
                    booth
                )


            if position.Y < 1
            and owner == "Unclaimed" then

                return booth

            end

        end

    end


    return nil

end


--========================================================--
-- CLAIM BOOTH
--========================================================--

local function claimBooth()

    local booth =
        getValidBooth()


    if not booth then

        warn(
            "[BOOTH] Tidak ada booth kosong."
        )

        return false

    end


    print(
        "[BOOTH] Trying to claim:",
        booth.Name
    )


    local success, err =
        pcall(function()

            claimBoothEvent:FireServer(
                booth
            )

        end)


    if not success then

        warn(
            "[BOOTH] Claim remote error:",
            tostring(err)
        )

        return false

    end


    local claimed =
        waitForClaim(
            booth,
            CLAIM_TIMEOUT
        )


    if claimed then

        print(
            "[BOOTH] SUCCESS:",
            booth.Name
        )

        return true

    end


    warn(
        "[BOOTH] Claim gagal."
    )


    return false

end


--========================================================--
-- GET PET WEIGHT
--========================================================--

local function getWeight(
    toolName
)

    local weight =
        toolName:match(
            "%[(%d+%.?%d*)%s*KG%]"
        )


    if weight then

        return tonumber(weight)

    end


    return nil

end


--========================================================--
-- CONFIG MATCH
--========================================================--

local function matchesTarget(
    petName,
    weight,
    price
)

    if not petName then

        return false

    end


    if not string.find(
        petName,
        TARGET_NAME,
        1,
        true
    ) then

        return false

    end


    if not weight then

        return false

    end


    if weight < MIN_KG then

        return false

    end


    if price ~= nil
    and price ~= PRICE then

        return false

    end


    return true

end


