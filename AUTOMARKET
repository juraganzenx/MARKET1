    task.wait(
        HOP_DELAY
    )


    local servers =
        getServers()


    if #servers == 0 then

        warn(
            "[SERVER HOP] Tidak ada server valid."
        )

        warn(
            "[SERVER HOP] Syarat: belum penuh + <= "
            .. tostring(MAX_HOP_PLAYERS)
