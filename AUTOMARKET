--========================================================--
-- GET PUBLIC SERVERS
--========================================================--

local function getServers()

    local servers = {}

    local cursor = ""


    repeat

        local url =
            "https://games.roblox.com/v1/games/"
            .. tostring(game.PlaceId)
            .. "/servers/Public?sortOrder=Desc&limit=100"


        if cursor ~= "" then

            url =
                url
                .. "&cursor="
                .. HttpService:UrlEncode(
                    cursor
                )

        end


        print(
            "[SERVER HOP] Request server list..."
        )


        local success, result =
            pcall(function()

                return game:HttpGet(
                    url
                )

            end)


        if not success then

            warn(
                "[SERVER HOP] HTTP ERROR:",
                tostring(result)
            )

            return servers

        end


        local decodeSuccess, data =
            pcall(function()

                return HttpService:JSONDecode(
                    result
                )

            end)


        if not decodeSuccess then

            warn(
                "[SERVER HOP] JSON DECODE ERROR:",
                tostring(data)
            )

            return servers

        end


        for _, server in ipairs(
            data.data or {}
        ) do

            --================================================--
            -- JANGAN KEMBALI KE SERVER SENDIRI
            --================================================--

            if server.id
                ~= game.JobId then

                local playing =
                    tonumber(
                        server.playing
                    ) or 0


                local maxPlayers =
                    tonumber(
                        server.maxPlayers
                    ) or 0


                --================================================--
                -- SERVER HARUS:
                --
                -- 1. Belum penuh
                -- 2. Player <= MAX_HOP_PLAYERS
                --================================================--

                if playing < maxPlayers
                    and playing <= MAX_HOP_PLAYERS then

                    table.insert(
                        servers,
                        server
                    )

                end

            end

        end


        cursor =
            data.nextPageCursor or ""


    until cursor == ""


    return servers

end


--========================================================--
-- GET SERVER TERAMAI
--========================================================--

local function getHighestServer(
    servers
)

    if #servers == 0 then
        return nil
    end


    --====================================================--
    -- URUTKAN DARI PLAYER TERBANYAK
    --====================================================--

    table.sort(
        servers,
        function(a, b)

            return
                (tonumber(a.playing) or 0)
                >
                (tonumber(b.playing) or 0)

        end
    )


    --====================================================--
    -- AMBIL SEMUA SERVER DENGAN JUMLAH PLAYER TERTINGGI
    --====================================================--

    local highestPlayers =
        tonumber(
            servers[1].playing
        ) or 0


    local candidates = {}


    for _, server in ipairs(
        servers
    ) do

        local playing =
            tonumber(
                server.playing
            ) or 0


        if playing == highestPlayers then

            table.insert(
                candidates,
                server
            )

        else

            break

        end

    end


    if #candidates == 0 then
        return nil
    end


    --====================================================--
    -- RANDOM JIKA JUMLAH PLAYER SAMA
    --====================================================--

    return candidates[
        math.random(
            1,
            #candidates
        )
    ]

end


