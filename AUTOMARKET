--========================================================--
-- LOAD BLACKLIST FROM GITHUB
--========================================================--
--
-- GitHub hanya dibaca saat awal execute.
--
-- Setelah data masuk ke local table,
-- pengecekan player dilakukan langsung dari
-- Players:GetPlayers() setiap monitor.
--
-- Jadi tidak request GitHub setiap 10 detik.
--========================================================--

local function loadBlacklistFromGitHub()

    print(
        "[BLACKLIST] Reading GitHub..."
    )

    local success, result =
        pcall(function()

            return game:HttpGet(
                BLACKLIST_URL
            )

        end)


    if not success then

        warn(
            "[BLACKLIST] GitHub request failed:",
            tostring(result)
        )

        return false

    end


    local decodeSuccess, data =
        pcall(function()

            return HttpService:JSONDecode(
                result
            )

        end)


    if not decodeSuccess then

        warn(
            "[BLACKLIST] JSON decode failed:",
            tostring(data)
        )

        return false

    end


    if typeof(data) ~= "table" then

        warn(
            "[BLACKLIST] Data bukan table."
        )

        return false

    end


    --====================================================--
    -- RESET DATA LAMA
    --====================================================--

    table.clear(
        blacklist
    )


    local count = 0


    --====================================================--
    -- FORMAT:
    --
    -- [
    --   {
    --      username="asepppy38",
    --      timestamp=...,
    --      userId=...
    --   }
    -- ]
    --====================================================--

    for _, entry in ipairs(data) do

        if typeof(entry) == "table" then

            local username =
                entry.username


            if username
            and tostring(username) ~= "" then

                local normalized =
                    tostring(username):lower()


                --================================================--
                -- USERNAME SENDIRI TIDAK DIMASUKKAN
                --================================================--

                if normalized
                    ~= LocalPlayer.Name:lower() then

                    blacklist[normalized] = true

                    count += 1

                end

            end

        end

    end


    print(
        "[BLACKLIST] Loaded:",
        count,
        "username"
    )


    print(
        "[BLACKLIST] My Username:",
        LocalPlayer.Name,
        "-> EXCLUDED"
    )


    return true

end


