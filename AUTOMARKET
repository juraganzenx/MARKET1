-- Listing
local TARGET_NAME = "Peryton"
local MIN_KG = 1.3
local PRICE = 1000
local PER_ITEM_DELAY = 10

-- Delay
local TRADE_WAIT = 3
local CLAIM_TIMEOUT = 5
local LIST_START_DELAY = 5
local REMOVE_DELAY = 0.2
local SCAN_DELAY = 60

