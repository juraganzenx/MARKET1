    local success, errorMessage =
        pcall(function()

            TeleportService:
                TeleportToPlaceInstance(
                    game.PlaceId,
                    server.id,
                    LocalPlayer
                )

        end)


    if not success then

        warn(
            "[SERVER HOP] TELEPORT ERROR:",
            tostring(errorMessage)
        )


        hopRunning = false

        return false

    end


    return true

end


