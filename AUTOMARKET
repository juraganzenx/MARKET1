--========================================================--
-- LOAD BLACKLIST FROM GITHUB
--========================================================--

local function loadBlacklist()

    blacklist = {}

    print(
        "[BLACKLIST] Reading GitHub..."
    )

    local success, result =
        pcall(function()

            return game:HttpGet(
                BLACKLIST_URL
            )

        end)


    if not success then

        warn(
            "[BLACKLIST] GitHub request failed:",
            tostring(result)
        )

        return false

    end


    local decodeSuccess, data =
        pcall(function()

            return HttpService:JSONDecode(
                result
            )

        end)


    if not decodeSuccess then

        warn(
            "[BLACKLIST] JSON decode failed:",
            tostring(data)
        )

        return false

    end


    if type(data) ~= "table" then

        warn(
            "[BLACKLIST] Data bukan table."
        )

        return false

    end


    local count = 0


    for _, entry in ipairs(data) do

        if type(entry) == "table" then

            local username =
                entry.username


            if username
            and type(username) == "string" then

                local lowerName =
                    username:lower()


                --================================================--
                -- JANGAN MASUKKAN USERNAME SENDIRI
                --================================================--

                if lowerName
                    ~= LocalPlayer.Name:lower() then

                    blacklist[lowerName] = true

                    count += 1

                end

            end

        end

    end


    print(
        "[BLACKLIST] Loaded:",
        count,
        "username"
    )


    print(
        "[BLACKLIST] Own username excluded:",
        LocalPlayer.Name
    )


    return true

end


