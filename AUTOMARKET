--========================================================--
-- REMOVE INVALID LISTINGS
--========================================================--

local function removeInvalidListings()

    print(
        "[REMOVE] Reading booth data..."
    )


    local data =
        getBoothData()


    if not data then

        warn(
            "[REMOVE] Booth data tidak tersedia."
        )

        return

    end


    local playerKey =
        "Player_"
        .. tostring(
            LocalPlayer.UserId
        )


    local playerData =
        data.Players
        and data.Players[playerKey]


    if not playerData then

        warn(
            "[REMOVE] Player booth data tidak ditemukan."
        )

        return

    end


    local listings =
        playerData.Listings


    if not listings then

        print(
            "[REMOVE] Tidak ada listing."
        )

        return

    end


    local items =
        playerData.Items or {}


    local checked = 0

    local kept = 0

    local removed = 0


    for listingId, listing in pairs(
        listings
    ) do

        checked += 1


        local item =
            items[listing.ItemId]


        local petType =
            item
            and item.PetType


        local petData =
            item
            and item.PetData


        local baseWeight =
            petData
            and petData.BaseWeight


        local price =
            listing.Price


        local valid =
            matchesTarget(
                petType,
                baseWeight,
                price
            )


        if valid then

            kept += 1


            print(
                string.format(
                    "[KEEP] %s | %.2f KG | PRICE=%s",
                    tostring(petType),
                    tonumber(baseWeight) or 0,
                    tostring(price)
                )
            )


        else

            removed += 1


            print(
                string.format(
                    "[REMOVE] %s | %.2f KG | PRICE=%s",
                    tostring(petType),
                    tonumber(baseWeight) or 0,
                    tostring(price)
                )
            )


            pcall(function()

                RemoveListing:InvokeServer(
                    listingId
                )

            end)


            task.wait(
                REMOVE_DELAY
            )

        end

    end


    print(
        string.format(
            "[REMOVE DONE] Checked=%d | Keep=%d | Removed=%d",
            checked,
            kept,
            removed
        )
    )

end


--========================================================--
-- LIST PET
--========================================================--

local function listPet(
    tool
)

    if not tool
    or not tool.Parent then

        return false

    end


    local uuid =
        tool:GetAttribute(
            "PET_UUID"
        )


    if not uuid then

        warn(
            "[LIST] PET_UUID tidak ditemukan:",
            tool.Name
        )

        return false

    end


    local args = {

        [1] = "Pet",

        [2] = uuid,

        [3] = PRICE

    }


    local success, result =
        pcall(function()

            return CreateListing:InvokeServer(
                unpack(args)
            )

        end)


    if success then

        print(
            string.format(
                "[LISTED] %s | KG=%s | UUID=%s | PRICE=%s",
                tool.Name,
                tostring(
                    getWeight(tool.Name)
                ),
                tostring(uuid),
                tostring(PRICE)
            )
        )


        return true

    else

        warn(
            "[LIST] Failed:",
            tostring(result)
        )


        return false

    end

end


--========================================================--
-- FIND PERYTON FOR LISTING
--========================================================--

local function getListingCandidates()

    local candidates = {}


    for _, tool in ipairs(
        Backpack:GetChildren()
    ) do

        if tool:IsA("Tool") then

            if string.find(
                tool.Name,
                TARGET_NAME,
                1,
                true
            ) then

                local weight =
                    getWeight(
                        tool.Name
                    )


                if weight
                and weight >= MIN_KG then

                    table.insert(
                        candidates,
                        tool
                    )

                end

            end

        end

    end


    return candidates

end


--========================================================--
-- AUTO LIST
--========================================================--

local function startAutoListing()

    if autoListingStarted then

        return

    end


    autoListingStarted = true


    print(
        "[AUTO LISTER] Waiting",
        LIST_START_DELAY,
        "seconds..."
    )


    task.wait(
        LIST_START_DELAY
    )


    while true do

        if isKicked then

            return

        end


        --================================================--
        -- HARUS TRADE WORLD
        --================================================--

        if game.PlaceId
            ~= TRADE_WORLD_ID then

            warn(
                "[AUTO LISTER] Tidak berada di Trade World."
            )

            return

        end


        --================================================--
        -- BLACKLIST CHECK
        --================================================--

        local badPlayer =
            isBlacklistedPlayerPresent()


        if badPlayer then

            warn(
                "[AUTO LISTER] Blacklist detected:",
                badPlayer
            )

            hopToHighestServer()

            return

        end


        local candidates =
            getListingCandidates()


        print(
            "[AUTO LISTER] Found:",
            #candidates
        )


        if #candidates == 0 then

            print(
                "[AUTO LISTER] Tidak ada Peryton yang memenuhi config."
            )

        end


        for _, tool in ipairs(
            candidates
        ) do

            if isKicked then

                return

            end


            if tool
            and tool.Parent == Backpack then

                listPet(tool)


                task.wait(
                    PER_ITEM_DELAY
                )

            end

        end


        task.wait(
            SCAN_DELAY
        )

    end

end


--========================================================--
-- PERYTON MONITOR
--========================================================--

local function startPerytonMonitor()

    task.spawn(function()

        while true do

            task.wait(
                PERYTON_CHECK_DELAY
            )


            if isKicked then

                return

            end


            local currentPeryton =
                getPerytonCount()


            local inTradeWorld =
                game.PlaceId
                == TRADE_WORLD_ID


            print(
                string.format(
                    "[MONITOR] Peryton=%d | World=%s",
                    currentPeryton,
                    inTradeWorld
                    and "TRADE"
                    or "MAIN"
                )
            )


            --================================================--
            -- TRADE WORLD
            --================================================--

            if inTradeWorld then

                --================================================--
                -- BLACKLIST
                --================================================--

                local badPlayer =
                    isBlacklistedPlayerPresent()


                if badPlayer then

                    warn(
                        "[MONITOR] BLACKLIST DETECTED:",
                        badPlayer
                    )

                    warn(
                        "[MONITOR] Blacklist hanya berlaku di Trade World."
                    )

                    warn(
                        "[MONITOR] Teleporting ke server lain..."
                    )


                    hopToHighestServer()


                    return

                end


                --================================================--
                -- PERYTON CHECK
                --================================================--

                if currentPeryton
                    < MIN_PERYTON then

                    warn(
                        "[MONITOR] Trade World + Peryton < "
                        .. tostring(MIN_PERYTON)
                    )


                    kickPlayer(
                        "Peryton habis di Trade World"
                    )


                    return

                else

                    print(
                        "[MONITOR] Trade World + Peryton >= "
                        .. tostring(MIN_PERYTON)
                        .. " -> tetap."
                    )

                end


            --================================================--
            -- MAIN WORLD
            --================================================--

            else

                if currentPeryton
                    >= MIN_PERYTON then

                    print(
                        "[MONITOR] Main World + Peryton >= "
                        .. tostring(MIN_PERYTON)
                    )


                    travelToTradeWorld()


                else

                    local requiredPresent =
                        isRequiredPlayerPresent()


                    if requiredPresent then

                        print(
                            "[MONITOR] Main World + Peryton < "
                            .. tostring(MIN_PERYTON)
                            .. " + "
                            .. REQUIRED_PLAYER
                            .. " ADA -> tunggu."
                        )

                    else

                        warn(
                            "[MONITOR] Main World + Peryton < "
                            .. tostring(MIN_PERYTON)
                            .. " + "
                            .. REQUIRED_PLAYER
                            .. " TIDAK ADA."
                        )


                        kickPlayer(
                            REQUIRED_PLAYER
                            .. " tidak ada di Main World"
                        )


                        return

                    end

                end

            end

        end

    end)

end


