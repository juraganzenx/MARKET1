--========================================================--
-- KICK
--========================================================--

local function kickPlayer(reason)

    if isKicked then
        return
    end

    isKicked = true


    warn(
        "[KICK]",
        tostring(reason)
    )


    pcall(function()

        LocalPlayer:Kick(
            tostring(reason)
        )

    end)

end


--========================================================--
-- TELEPORT TO NEW TRADE WORLD SERVER
--========================================================--

local function teleportToNewTradeServer(
    reason
)

    if blacklistTeleporting then
        return false
    end


    if isKicked then
        return false
    end


    blacklistTeleporting = true


    warn(
        "[BLACKLIST]",
        tostring(reason)
    )


    warn(
        "[BLACKLIST] Teleporting to another Trade World server..."
    )


    local success, err =
        pcall(function()

            TeleportService:Teleport(
                TRADE_WORLD_ID,
                LocalPlayer
            )

        end)


    if not success then

        warn(
            "[BLACKLIST] Teleport failed:",
            tostring(err)
        )

        blacklistTeleporting = false

        return false

    end


    return true

end


--========================================================--
-- GET PERYTON COUNT
--========================================================--

local function getPerytonCount()

    local count = 0


    --====================================================--
    -- BACKPACK
    --====================================================--

    for _, tool in ipairs(
        Backpack:GetChildren()
    ) do

        if tool:IsA("Tool") then

            if string.find(
                tool.Name,
                TARGET_NAME,
                1,
                true
            ) then

                count += 1

            end

        end

    end


    --====================================================--
    -- CHARACTER
    --====================================================--

    if LocalPlayer.Character then

        for _, tool in ipairs(
            LocalPlayer.Character:GetChildren()
        ) do

            if tool:IsA("Tool") then

                if string.find(
                    tool.Name,
                    TARGET_NAME,
                    1,
                    true
                ) then

                    count += 1

                end

            end

        end

    end


    return count

end


