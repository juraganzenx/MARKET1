local function isBlacklistedPlayerPresent()

    --====================================================--
    -- HANYA DIPAKAI DI TRADE WORLD
    --====================================================--

    if game.PlaceId ~= TRADE_WORLD_ID then

        return nil

    end


    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        -- Jangan pernah target diri sendiri
        if player ~= LocalPlayer then

            local username =
                player.Name:lower()


            if username
                ~= LocalPlayer.Name:lower() then

                if blacklist[username] then

                    return player.Name

                end

            end

        end

    end


    return nil

end


