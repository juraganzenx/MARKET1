    if claimed then

        print(
            "[BOOTH] SUCCESS:",
            booth.Name
        )


        return true

    end


    warn(
        "[BOOTH] Claim gagal."
    )


    return false

end


--========================================================--
-- GET PET WEIGHT
--========================================================--

local function getWeight(
    toolName
)

    local weight =
        toolName:match(
            "%[(%d+%.?%d*)%s*KG%]"
        )


    if weight then

        return tonumber(
            weight
        )

    end


    return nil

end


--========================================================--
-- CONFIG MATCH
--========================================================--

local function matchesTarget(
    petName,
    weight,
    price
)

    if not petName then

        return false

    end


    if not string.find(
        petName,
        TARGET_NAME,
        1,
        true
    ) then

        return false

    end


    if not weight then

        return false

    end


    if weight < MIN_KG then

        return false

    end


    if price ~= nil
    and price ~= PRICE then

        return false

    end


    return true

end


