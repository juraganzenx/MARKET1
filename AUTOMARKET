--========================================================--
-- REMOVE INVALID LISTINGS
--========================================================--

local function removeInvalidListings()

    print(
        "[REMOVE] Reading booth data..."
    )


    local data =
        getBoothData()


    if not data then

        warn(
            "[REMOVE] Booth data tidak tersedia."
        )


        return

    end


    local playerKey =
        "Player_"
        .. tostring(
            LocalPlayer.UserId
        )


    local playerData =
        data.Players
        and data.Players[playerKey]


    if not playerData then

        warn(
            "[REMOVE] Player booth data tidak ditemukan."
        )


        return

    end


    local listings =
        playerData.Listings


    if not listings then

        print(
            "[REMOVE] Tidak ada listing."
        )


        return

    end


    local items =
        playerData.Items
        or {}


    local checked = 0

    local kept = 0

    local removed = 0


    for listingId, listing in pairs(
        listings
    ) do

        checked += 1


        local item =
            items[listing.ItemId]


        local petType =
            item
            and item.PetType


        local petData =
            item
            and item.PetData


        local baseWeight =
            petData
            and petData.BaseWeight


        local price =
            listing.Price


        local valid =
            matchesTarget(
                petType,
                baseWeight,
                price
            )


        if valid then

            kept += 1


            print(
                string.format(
                    "[KEEP] %s | %.2f KG | PRICE=%s",
                    tostring(petType),
                    tonumber(baseWeight) or 0,
                    tostring(price)
                )
            )


        else

            removed += 1


            print(
                string.format(
                    "[REMOVE] %s | %.2f KG | PRICE=%s",
                    tostring(petType),
                    tonumber(baseWeight) or 0,
                    tostring(price)
                )
            )


            pcall(function()

                RemoveListing:InvokeServer(
                    listingId
                )

            end)


            task.wait(
                REMOVE_DELAY
            )

        end

    end


    print(
        string.format(
            "[REMOVE DONE] Checked=%d | Keep=%d | Removed=%d",
            checked,
            kept,
            removed
        )
    )

end


--========================================================--
-- LIST PET
--========================================================--

local function listPet(
    tool
)

    if not tool
    or not tool.Parent then

        return false

    end


    local uuid =
        tool:GetAttribute(
            "PET_UUID"
        )


    if not uuid then

        warn(
            "[LIST] PET_UUID tidak ditemukan:",
            tool.Name
        )


        return false

    end


    local args = {

        [1] = "Pet",

        [2] = uuid,

        [3] = PRICE

    }


    local success, result =
        pcall(function()

            return CreateListing:InvokeServer(
                unpack(args)
            )

        end)


    if success then

        print(
            string.format(
                "[LISTED] %s | KG=%s | UUID=%s | PRICE=%s",
                tool.Name,
                tostring(
                    getWeight(
                        tool.Name
                    )
                ),
                tostring(uuid),
                tostring(PRICE)
            )
        )


        return true

    else

        warn(
            "[LIST] Failed:",
            tostring(result)
        )


        return false

    end

end


--========================================================--
-- FIND PERYTON FOR LISTING
--========================================================--

local function getListingCandidates()

    local candidates = {}


    for _, tool in ipairs(
        Backpack:GetChildren()
    ) do

        if tool:IsA("Tool") then

            if string.find(
                tool.Name,
                TARGET_NAME,
                1,
                true
            ) then

                local weight =
                    getWeight(
                        tool.Name
                    )


                if weight
                and weight >= MIN_KG then

                    table.insert(
                        candidates,
                        tool
                    )

                end

            end

        end

    end


    return candidates

end


--========================================================--
-- AUTO LIST
--========================================================--

local function startAutoListing()

    if autoListingStarted then

        return

    end


    autoListingStarted = true


    print(
        "[AUTO LISTER] Waiting",
        LIST_START_DELAY,
        "seconds..."
    )


    task.wait(
        LIST_START_DELAY
    )


    while true do

        if isKicked then

            return

        end


        -- Jika kembali ke Main World,
        -- stop Auto Listing.
        if game.PlaceId ~= TRADE_WORLD_ID then

            warn(
                "[AUTO LISTER] Tidak berada di Trade World."
            )


            return

        end


        local candidates =
            getListingCandidates()


        print(
            "[AUTO LISTER] Found:",
            #candidates
        )


        if #candidates == 0 then

            print(
                "[AUTO LISTER] Tidak ada Peryton yang memenuhi config."
            )

        end


        for _, tool in ipairs(
            candidates
        ) do

            if isKicked then

                return

            end


            if tool
            and tool.Parent == Backpack then

                listPet(
                    tool
                )


                task.wait(
                    PER_ITEM_DELAY
                )

            end

        end


        task.wait(
            SCAN_DELAY
        )

    end

end


--========================================================--
-- GET PUBLIC SERVERS
--========================================================--
-- Mengambil server public untuk TRADE WORLD.
--
-- Filter:
-- 1. Bukan JobId sekarang
-- 2. Belum penuh
--========================================================--

local function getPublicServers()

    local servers = {}

    local cursor = ""


    repeat

        local url =
            "https://games.roblox.com/v1/games/"
            .. tostring(
                TRADE_WORLD_ID
            )
            .. "/servers/Public?sortOrder=Desc&limit=100"


        if cursor ~= "" then

            url =
                url
                .. "&cursor="
                .. HttpService:UrlEncode(
                    cursor
                )

        end


        print(
            "[SERVER HOP] Request server list..."
        )


        local success, response =
            pcall(function()

                return game:HttpGet(
                    url
                )

            end)


        if not success then

            warn(
                "[SERVER HOP] HTTP ERROR:",
                tostring(response)
            )


            return servers

        end


        local decodeSuccess, data =
            pcall(function()

                return HttpService:JSONDecode(
                    response
                )

            end)


        if not decodeSuccess then

            warn(
                "[SERVER HOP] JSON DECODE ERROR"
            )


            return servers

        end


        for _, server in ipairs(
            data.data or {}
        ) do

            --================================================--
            -- JANGAN KEMBALI KE SERVER SEKARANG
            --================================================--

            if server.id ~= game.JobId

            --================================================--
            -- HARUS MASIH ADA SLOT
            --================================================--

            and server.playing < server.maxPlayers then

                table.insert(
                    servers,
                    server
                )

            end

        end


        cursor =
            data.nextPageCursor
            or ""


    until cursor == ""


    return servers

end


--========================================================--
-- FIND BUSIEST SERVER
--========================================================--
-- TERAMAI TAPI BELUM PENUH.
--========================================================--

local function getBusiestServer(
    servers
)

    if #servers == 0 then

        return nil

    end


    table.sort(
        servers,
        function(a, b)

            return a.playing > b.playing

        end
    )


    return servers[1]

end


--========================================================--
-- TELEPORT TO BUSIEST TRADE SERVER
--========================================================--

local function teleportToNewTradeServer(
    reason
)

    if blacklistTeleporting then

        return false

    end


    if isKicked then

        return false

    end


    blacklistTeleporting = true


    warn(
        "[BLACKLIST]",
        tostring(reason)
    )


    print(
        "=========================================="
    )


    print(
        "[SERVER HOP] Blacklist detected."
    )


    print(
        "[SERVER HOP] Mencari Trade World server TERAMAI..."
    )


    print(
        "[SERVER HOP] Syarat: belum penuh."
    )


    print(
        "=========================================="
    )


    task.wait(
        HOP_DELAY
    )


    local servers =
        getPublicServers()


    if #servers == 0 then

        warn(
            "[SERVER HOP] Tidak ada server Trade World tersedia."
        )


        blacklistTeleporting = false


        return false

    end


    --====================================================--
    -- SORT TERAMAI
    --====================================================--

    table.sort(
        servers,
        function(a, b)

            return a.playing > b.playing

        end
    )


    --====================================================--
    -- DEBUG TOP 10
    --====================================================--

    print(
        "=========================================="
    )


    print(
        "[SERVER HOP] TOP 10 SERVER TRADE TERAMAI"
    )


    print(
        "=========================================="
    )


    for i = 1, math.min(
        10,
        #servers
    ) do

        local server =
            servers[i]


        print(
            i,
            "| Players:",
            server.playing,
            "/",
            server.maxPlayers,
            "| JobId:",
            server.id
        )

    end


    --====================================================--
    -- SELECT
    --====================================================--

    local targetServer =
        getBusiestServer(
            servers
        )


    if not targetServer then

        warn(
            "[SERVER HOP] Gagal memilih server."
        )


        blacklistTeleporting = false


        return false

    end


    print(
        "=========================================="
    )


    print(
        "[SERVER HOP] SERVER TERPILIH"
    )


    print(
        "[SERVER HOP] Players:",
        targetServer.playing,
        "/",
        targetServer.maxPlayers
    )


    print(
        "[SERVER HOP] JobId:",
        targetServer.id
    )


    print(
        "[SERVER HOP] Current JobId:",
        game.JobId
    )


    print(
        "=========================================="
    )


    --====================================================--
    -- TELEPORT
    --====================================================--

    local success, err =
        pcall(function()

            TeleportService:TeleportToPlaceInstance(
                TRADE_WORLD_ID,
                targetServer.id,
                LocalPlayer
            )

        end)


    if not success then

        warn(
            "[SERVER HOP] TELEPORT ERROR:",
            tostring(err)
        )


        blacklistTeleporting = false


        return false

    end


    print(
        "[SERVER HOP] Teleport request sent."
    )


    return true

end


