local function getListingCandidates()

    local candidates = {}


    for _, tool in ipairs(
        Backpack:GetChildren()
    ) do

        if tool:IsA("Tool") then

            if string.find(
                tool.Name,
                TARGET_NAME,
                1,
                true
            ) then

                local weight =
                    getWeight(
                        tool.Name
                    )


                if weight
                and weight >= MIN_KG then

                    table.insert(
                        candidates,
                        tool
                    )

                end

            end

        end

    end


    return candidates

end


--========================================================--
-- AUTO LIST
--========================================================--

local function startAutoListing()

    if autoListingStarted then
        return
    end


    autoListingStarted = true


    print(
        "[AUTO LISTER] Waiting",
        LIST_START_DELAY,
        "seconds..."
    )


    task.wait(
        LIST_START_DELAY
    )


    while true do

        if isKicked then
            return
        end


        --================================================--
        -- HARUS TRADE WORLD
        --================================================--

        if game.PlaceId ~= TRADE_WORLD_ID then

            warn(
                "[AUTO LISTER] Tidak berada di Trade World."
            )


            return

        end


        --================================================--
        -- BLACKLIST CHECK
        --================================================--

        local blacklisted =
            getBlacklistedPlayer()


        if blacklisted then

            warn(
                "[AUTO LISTER] Blacklisted player detected:",
                blacklisted.Name
            )


            warn(
                "[AUTO LISTER] -> SERVER HOP"
            )


            hopToHighestServer()


            return

        end


        --================================================--
        -- PERYTON CHECK
        --================================================--

        local currentPeryton =
            getPerytonCount()


        if currentPeryton < MIN_PERYTON then

            warn(
                "[AUTO LISTER] Peryton habis."
            )


            return

        end


        --================================================--
        -- FIND CANDIDATES
        --================================================--

        local candidates =
            getListingCandidates()


        print(
            "[AUTO LISTER] Found:",
            #candidates
        )


        if #candidates == 0 then

            print(
                "[AUTO LISTER] Tidak ada Peryton yang memenuhi config."
            )

        end


        for _, tool in ipairs(
            candidates
        ) do

            if isKicked then
                return
            end


            if hopRunning then
                return
            end


            if tool
            and tool.Parent == Backpack then

                listPet(
                    tool
                )


                task.wait(
                    PER_ITEM_DELAY
                )

            end

        end


        task.wait(
            SCAN_DELAY
        )

    end

end


--========================================================--
-- PERYTON MONITOR
--========================================================--
--
-- LOOP TETAP:
-- Setiap 10 detik baca ulang:
--
-- 1. Peryton
-- 2. World
-- 3. Required Player
-- 4. Blacklist player
--
-- GitHub TIDAK dibaca ulang.
-- Nama player dicek langsung setiap loop.
--========================================================--

local function startPerytonMonitor()

    task.spawn(function()

        while true do

            task.wait(
                PERYTON_CHECK_DELAY
            )


            if isKicked then
                return
            end


            if hopRunning then
                continue
            end


            local currentPeryton =
                getPerytonCount()


            local inTradeWorld =
                game.PlaceId
                == TRADE_WORLD_ID


            print(
                string.format(
                    "[MONITOR] Peryton=%d | World=%s",
                    currentPeryton,
                    inTradeWorld
                    and "TRADE"
                    or "MAIN"
                )
            )


            --================================================--
            -- MAIN WORLD
            --================================================--

            if not inTradeWorld then

                --================================================--
                -- PERYTON ADA
                --================================================--

                if currentPeryton >= MIN_PERYTON then

                    print(
                        "[MONITOR] Main World + Peryton >= "
                        .. tostring(MIN_PERYTON)
                    )


                    travelToTradeWorld()


                else

                    --================================================--
                    -- PERYTON TIDAK ADA
                    --================================================--

                    local requiredPresent =
                        isRequiredPlayerPresent()


                    if requiredPresent then

                        print(
                            "[MONITOR] Main World + Peryton < "
                            .. tostring(MIN_PERYTON)
                            .. " + "
                            .. REQUIRED_PLAYER
                            .. " ADA -> tunggu."
                        )

                    else

                        warn(
                            "[MONITOR] Main World + Peryton < "
                            .. tostring(MIN_PERYTON)
                            .. " + "
                            .. REQUIRED_PLAYER
                            .. " TIDAK ADA."
                        )


                        kickPlayer(
                            REQUIRED_PLAYER
                            .. " tidak ada di Main World"
                        )


                        return

                    end

                end


            --================================================--
            -- TRADE WORLD
            --================================================--

            else

                --================================================--
                -- BLACKLIST CHECK
                --
                -- HANYA DI TRADE WORLD
                --
                -- Username sendiri otomatis dikecualikan.
                --================================================--

                local blacklisted =
                    getBlacklistedPlayer()


                if blacklisted then

                    warn(
                        "=========================================="
                    )


                    warn(
                        "[BLACKLIST] PLAYER DETECTED:",
                        blacklisted.Name
                    )


                    warn(
                        "[BLACKLIST] My Username:",
                        LocalPlayer.Name
                    )


                    warn(
                        "[BLACKLIST] -> SERVER HOP"
                    )


                    warn(
                        "=========================================="
                    )


                    hopToHighestServer()


                    return

                end


                --================================================--
                -- PERYTON CHECK
                --================================================--

                if currentPeryton < MIN_PERYTON then

                    warn(
                        "[MONITOR] Trade World + Peryton < "
                        .. tostring(MIN_PERYTON)
                    )


                    kickPlayer(
                        "Peryton habis di Trade World"
                    )


                    return

                else

                    print(
                        "[MONITOR] Trade World + Peryton >= "
                        .. tostring(MIN_PERYTON)
                        .. " -> tetap."
                    )

                end

            end

        end

    end)

end


