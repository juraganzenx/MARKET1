    --====================================================--
    -- SELECT
    --====================================================--

    local server =
        getHighestServer(
            servers
        )


    if not server then

        warn(
            "[SERVER HOP] Gagal memilih server."
        )


        hopRunning = false

        return false

    end


    print(
        "=========================================="
    )

    print(
        "[SERVER HOP] SERVER TERPILIH"
    )

    print(
        "[SERVER HOP] Players:",
        tostring(server.playing),
        "/",
        tostring(server.maxPlayers)
    )

    print(
        "[SERVER HOP] JobId:",
        tostring(server.id)
    )

    print(
        "=========================================="
    )


    --====================================================--
