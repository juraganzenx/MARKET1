--========================================================--
-- BLACKLIST
--========================================================--

local blacklist = {
    ["Ochil_28"] = true,
    ["setokmimic"] = true,
    ["CihuyyXuhuyyy11"] = true
}

--========================================================--
-- GET PERYTON COUNT
--========================================================--

local function getPerytonCount()

    local count = 0

    for _, tool in ipairs(Backpack:GetChildren()) do

        if tool:IsA("Tool") then

            if string.find(
                tool.Name,
                "Peryton",
                1,
                true
            ) then

                count += 1

            end
        end
    end

    -- Character
    if LocalPlayer.Character then

        for _, tool in ipairs(
            LocalPlayer.Character:GetChildren()
        ) do

            if tool:IsA("Tool") then

                if string.find(
                    tool.Name,
                    "Peryton",
                    1,
                    true
                ) then

                    count += 1

                end
            end
        end
    end

    return count
end

--========================================================--
-- TELEPORT TARGET SERVER
--========================================================--

local function teleportToTargetServer()

    if TARGET_SERVER_JOB_ID == "" then

        warn(
            "[PERYTON] TARGET_SERVER_JOB_ID belum diisi."
        )

        return false
    end

    local success, err =
        pcall(function()

            TeleportService:TeleportToPlaceInstance(
                game.PlaceId,
                TARGET_SERVER_JOB_ID,
                LocalPlayer
            )

        end)

    if success then

        print(
            "[PERYTON] Teleport ke target server..."
        )

        return true

    else

        warn(
            "[PERYTON] Teleport gagal:",
            err
        )

        return false
    end
end

--========================================================--
-- BLACKLIST CHECK
--========================================================--

local function isBlacklistedPlayerPresent()

    for _, player in ipairs(
        Players:GetPlayers()
    ) do

        if player ~= LocalPlayer then

            if blacklist[player.Name] then

                return player.Name

            end
        end
    end

    return nil
end

--========================================================--
-- GET BOOTH OWNER
--========================================================--

local function getBoothOwnerFromSurfaceGui(booth)

    for _, d in ipairs(
        booth:GetDescendants()
    ) do

        if d:IsA("SurfaceGui") then

            for _, g in ipairs(
                d:GetDescendants()
            ) do

                if g:IsA("TextLabel") then

                    local txt = g.Text

                    if txt and txt ~= "" then

                        local lower =
                            txt:lower()

                        if lower:find("claim")
                        or lower:find("rent")
                        or lower:find("empty")
                        or lower:find("buy")
                        or lower:find("open") then

                            continue
                        end

                        if #txt >= 3
                        and #txt <= 20 then

                            return txt

                        end
                    end
                end
            end
        end
    end

    return "Unclaimed"
end

--========================================================--
-- WAIT CLAIM
--========================================================--

local function waitForClaim(
    booth,
    timeout
)

    local elapsed = 0

    while elapsed < timeout do

        local owner =
            getBoothOwnerFromSurfaceGui(
                booth
            )

        if owner ~= "Unclaimed" then

            return true
        end

        task.wait(0.5)

        elapsed += 0.5
    end

    return false
end

--========================================================--
-- FIND EMPTY BOOTH
--========================================================--

local function getValidBooth()

    local tradeWorld =
        workspace:WaitForChild(
            "TradeWorld"
        )

    local booths =
        tradeWorld:WaitForChild(
            "Booths"
        )

    for _, booth in ipairs(
        booths:GetChildren()
    ) do

        local success, position =
            pcall(function()

                return booth:GetPivot().Position

            end)

        if success and position then

            local owner =
                getBoothOwnerFromSurfaceGui(
                    booth
                )

            if position.Y < 1
            and owner == "Unclaimed" then

                return booth
            end
        end
    end

    return nil
end

--========================================================--
-- CLAIM BOOTH
--========================================================--

local function claimBooth()

    local booth =
        getValidBooth()

    if not booth then

        warn(
            "[BOOTH] Tidak ada booth kosong."
        )

        return false
    end

    print(
        "[BOOTH] Trying to claim:",
        booth.Name
    )

    local success, err =
        pcall(function()

            claimBoothEvent:FireServer(
                booth
            )

        end)

    if not success then

        warn(
            "[BOOTH] Claim remote error:",
            err
        )

        return false
    end

    local claimed =
        waitForClaim(
            booth,
            CLAIM_TIMEOUT
        )

    if claimed then

        print(
            "[BOOTH] SUCCESS:",
            booth.Name
        )

        return true
    end

    warn(
        "[BOOTH] Claim gagal."
    )

    return false
end

--========================================================--
-- GET PET WEIGHT FROM TOOL
--========================================================--

local function getWeight(toolName)

    local weight =
        toolName:match(
            "%[(%d+%.?%d*)%s*KG%]"
        )

    if weight then

        return tonumber(weight)
    end

    return nil
end

--========================================================--
-- CONFIG MATCH
--========================================================--

local function matchesTarget(
    petName,
    weight,
    price
)

    if not petName then
        return false
    end

    if not string.find(
        petName,
        TARGET_NAME,
        1,
        true
    ) then

        return false
    end

    if not weight then
        return false
    end

    if weight < MIN_KG then
        return false
    end

    if price ~= nil
    and price ~= PRICE then

        return false
    end

    return true
end

--========================================================--
-- GET BOOTH DATA
--========================================================--

local function getBoothData()

    if not BoothReplication then

        warn(
            "[BOOTH DATA] ReplicationReciever unavailable."
        )

        return nil
    end

    local success, data =
        pcall(function()

            return BoothReplication:GetDataAsync()

        end)

    if not success then

        warn(
            "[BOOTH DATA] Failed:",
            data
        )

        return nil
    end

    return data
end

--========================================================--
-- REMOVE INVALID LISTINGS
--========================================================--

local function removeInvalidListings()

    print(
        "[REMOVE] Reading booth data..."
    )

    local data =
        getBoothData()

    if not data then

        warn(
            "[REMOVE] Booth data tidak tersedia."
        )

        return
    end

    local playerKey =
        "Player_" ..
        tostring(
            LocalPlayer.UserId
        )

    local playerData =
        data.Players
        and data.Players[playerKey]

    if not playerData then

        warn(
            "[REMOVE] Player booth data tidak ditemukan."
        )

        return
    end

    local listings =
        playerData.Listings

    if not listings then

        print(
            "[REMOVE] Tidak ada listing."
        )

        return
    end

    local items =
        playerData.Items or {}

    local checked = 0
    local kept = 0
    local removed = 0

    for listingId, listing in pairs(
        listings
    ) do

        checked += 1

        local item =
            items[listing.ItemId]

        local petType =
            item
            and item.PetType

        local petData =
            item
            and item.PetData

        local baseWeight =
            petData
            and petData.BaseWeight

        local price =
            listing.Price

        local valid =
            matchesTarget(
                petType,
                baseWeight,
                price
            )

        if valid then

            kept += 1

            print(
                string.format(
                    "[KEEP] %s | %.2f KG | PRICE=%s",
                    tostring(petType),
                    tonumber(baseWeight) or 0,
                    tostring(price)
                )
            )

        else

            removed += 1

            print(
                string.format(
                    "[REMOVE] %s | %.2f KG | PRICE=%s",
                    tostring(petType),
                    tonumber(baseWeight) or 0,
                    tostring(price)
                )
            )

            pcall(function()

                RemoveListing:InvokeServer(
                    listingId
                )

            end)

            task.wait(
                REMOVE_DELAY
            )
        end
    end

    print(
        string.format(
            "[REMOVE DONE] Checked=%d | Keep=%d | Removed=%d",
            checked,
            kept,
            removed
        )
    )
end

--========================================================--
-- LIST PET
--========================================================--

local function listPet(tool)

    if not tool
    or not tool.Parent then

        return false
    end

    local uuid =
        tool:GetAttribute(
            "PET_UUID"
        )

    if not uuid then

        warn(
            "[LIST] PET_UUID tidak ditemukan:",
            tool.Name
        )

        return false
    end

    local args = {
        [1] = "Pet",
        [2] = uuid,
        [3] = PRICE
    }

    local success, result =
        pcall(function()

            return CreateListing:InvokeServer(
                unpack(args)
            )

        end)

    if success then

        print(
            string.format(
                "[LISTED] %s | KG=%s | UUID=%s | PRICE=%s",
                tool.Name,
                tostring(
                    getWeight(tool.Name)
                ),
                tostring(uuid),
                tostring(PRICE)
            )
        )

        return true

    else

        warn(
            "[LIST] Failed:",
            result
        )

        return false
    end
end

--========================================================--
-- FIND PERYTON FOR LISTING
--========================================================--

local function getListingCandidates()

    local candidates = {}

    for _, tool in ipairs(
        Backpack:GetChildren()
    ) do

        if tool:IsA("Tool") then

            if string.find(
                tool.Name,
                TARGET_NAME,
                1,
                true
            ) then

                local weight =
                    getWeight(
                        tool.Name
                    )

                if weight
                and weight >= MIN_KG then

                    table.insert(
                        candidates,
                        tool
                    )
                end
            end
        end
    end

    return candidates
end

--========================================================--
-- AUTO LIST
--========================================================--

local function startAutoListing()

    print(
        "[AUTO LISTER] Waiting",
        LIST_START_DELAY,
        "seconds..."
    )

    task.wait(
        LIST_START_DELAY
    )

    while true do

        local candidates =
            getListingCandidates()

        print(
            "[AUTO LISTER] Found:",
            #candidates
        )

        if #candidates == 0 then

            print(
                "[AUTO LISTER] Tidak ada Peryton yang memenuhi config."
            )

        end

        for _, tool in ipairs(
            candidates
        ) do

            if tool
            and tool.Parent == Backpack then

                listPet(tool)

                task.wait(
                    PER_ITEM_DELAY
                )
            end
        end

        task.wait(
            SCAN_DELAY
        )
    end
end

