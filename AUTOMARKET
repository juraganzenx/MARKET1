--========================================================--
-- LOAD BLACKLIST FROM GITHUB
--========================================================--
-- Hanya dilakukan ketika script pertama kali dijalankan.
--
-- Setelah itu pengecekan player menggunakan table lokal.
-- Jadi tidak request GitHub setiap 10 detik.
--========================================================--

local function loadBlacklistFromGitHub()

    print(
        "[BLACKLIST] Reading GitHub..."
    )


    local success, response =
        pcall(function()

            return game:HttpGet(
                BLACKLIST_URL
            )

        end)


    if not success then

        warn(
            "[BLACKLIST] HTTP ERROR:",
            tostring(response)
        )

        return false

    end


    local decodeSuccess, data =
        pcall(function()

            return HttpService:JSONDecode(
                response
            )

        end)


    if not decodeSuccess then

        warn(
            "[BLACKLIST] JSON DECODE ERROR"
        )

        return false

    end


    if typeof(data) ~= "table" then

        warn(
            "[BLACKLIST] Format JSON tidak valid."
        )

        return false

    end


    local count = 0


    for _, entry in ipairs(data) do

        if typeof(entry) == "table" then

            local username =
                entry.username


            if username
            and tostring(username) ~= "" then

                local normalized =
                    string.lower(
                        tostring(username)
                    )


                --================================================--
                -- JANGAN MASUKKAN USERNAME SENDIRI
                --================================================--

                if normalized
                    ~= string.lower(
                        LocalPlayer.Name
                    ) then

                    blacklist[
                        normalized
                    ] = true

                    count += 1

                end

            end

        end

    end


    print(
        "[BLACKLIST] Loaded:",
        count,
        "username"
    )


    print(
        "[BLACKLIST] My Username:",
        LocalPlayer.Name
    )


    print(
        "[BLACKLIST] My username excluded: YES"
    )


    return true

end


