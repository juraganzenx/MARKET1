--========================================================--
-- GET PUBLIC SERVERS
--========================================================--

local function getServers()

    local Servers = {}

    local Cursor = ""


    repeat

        local Url =
            "https://games.roblox.com/v1/games/"
            .. game.PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"


        if Cursor ~= "" then

            Url =
                Url
                .. "&cursor="
                .. HttpService:UrlEncode(
                    Cursor
                )

        end


        print(
            "[SERVER HOP] Request server list..."
        )


        local Success, Result =
            pcall(function()

                return game:HttpGet(
                    Url
                )

            end)


        if not Success then

            warn(
                "[SERVER HOP] HTTP ERROR:",
                tostring(Result)
            )

            return Servers

        end


        local DecodeSuccess, Data =
            pcall(function()

                return HttpService:JSONDecode(
                    Result
                )

            end)


        if not DecodeSuccess then

            warn(
                "[SERVER HOP] JSON DECODE ERROR"
            )

            return Servers

        end


        for _, Server in ipairs(
            Data.data or {}
        ) do

            --================================================--
            -- JANGAN KEMBALI KE SERVER SEKARANG
            --================================================--

            if Server.id ~= game.JobId

                --================================================--
                -- HARUS BELUM PENUH
                --================================================--

                and Server.playing
                    < Server.maxPlayers

                --================================================--
                -- MAKSIMAL 25 PLAYER
                --================================================--

                and Server.playing
                    <= MAX_TARGET_PLAYERS then


                table.insert(
                    Servers,
                    Server
                )

            end

        end


        Cursor =
            Data.nextPageCursor or ""


    until Cursor == ""


    return Servers

end


--========================================================--
-- GET SERVER TERAMAI
--========================================================--

local function getHighestServer(
    Servers
)

    if #Servers == 0 then

        return nil

    end


    table.sort(
        Servers,
        function(A, B)

            return A.playing > B.playing

        end
    )


    local HighestPlayers =
        Servers[1].playing


    local Candidates = {}


    for _, Server in ipairs(
        Servers
    ) do

        if Server.playing
            == HighestPlayers then

            table.insert(
                Candidates,
                Server
            )

        else

            break

        end

    end


    if #Candidates == 0 then

        return nil

    end


    return Candidates[
        math.random(
            1,
            #Candidates
        )
    ]

end


--========================================================--
-- HOP TO SERVER TERAMAI
--========================================================--

local function hopToHighestServer()

    if HopRunning then

        return false

    end


    HopRunning = true


    print(
        "=========================================="
    )

    print(
        "[SERVER HOP] Mencari server teramai..."
    )

    print(
        "[SERVER HOP] Maksimal:",
        MAX_TARGET_PLAYERS,
        "player"
    )

    print(
        "=========================================="
    )


    task.wait(
        HOP_DELAY
    )


    local Servers =
        getServers()


    if #Servers == 0 then

        warn(
            "[SERVER HOP] Tidak ada server yang memenuhi config."
        )

        HopRunning = false

        return false

    end


    --====================================================--
    -- SORT TERAMAI
    --====================================================--

    table.sort(
        Servers,
        function(A, B)

            return A.playing > B.playing

        end
    )


    --====================================================--
    -- DEBUG TOP 10
    --====================================================--

    print(
        "=========================================="
    )

    print(
        "[SERVER HOP] TOP 10 SERVER TERAMAI"
    )

    print(
        "[SERVER HOP] MAX PLAYER:",
        MAX_TARGET_PLAYERS
    )

    print(
        "=========================================="
    )


    for i = 1, math.min(
        10,
        #Servers
    ) do

        local Server =
            Servers[i]


        print(
            i,
            "| Players:",
            Server.playing,
            "/",
            Server.maxPlayers,
            "| JobId:",
            Server.id
        )

    end


    --====================================================--
    -- SELECT SERVER
    --====================================================--

    local Server =
        getHighestServer(
            Servers
        )


    if not Server then

        warn(
            "[SERVER HOP] Gagal memilih server."
        )

        HopRunning = false

        return false

    end


    print(
        "=========================================="
    )

    print(
        "[SERVER HOP] SERVER TERPILIH"
    )

    print(
        "[SERVER HOP] Players:",
        Server.playing,
        "/",
        Server.maxPlayers
    )

    print(
        "[SERVER HOP] JobId:",
        Server.id
    )

    print(
        "=========================================="
    )


    --====================================================--
    -- TELEPORT KE INSTANCE SERVER
    --====================================================--

    local Success, Error =
        pcall(function()

            TeleportService:
                TeleportToPlaceInstance(
                    game.PlaceId,
                    Server.id,
                    LocalPlayer
                )

        end)


    if not Success then

        warn(
            "[SERVER HOP] TELEPORT ERROR:",
            tostring(Error)
        )

        HopRunning = false

        return false

    end


    return true

end


