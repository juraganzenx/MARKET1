local blacklist = {}


--========================================================--
-- LOAD BLACKLIST FROM GITHUB
--========================================================--

local function loadBlacklist()

    print(
        "[BLACKLIST] Loading from GitHub..."
    )


    local success, response =
        pcall(function()

            return game:HttpGet(
                BLACKLIST_URL
            )

        end)


    if not success then

        warn(
            "[BLACKLIST] Download failed:",
            tostring(response)
        )

        return false

    end


    local decodeSuccess, data =
        pcall(function()

            return HttpService:JSONDecode(
                response
            )

        end)


    if not decodeSuccess then

        warn(
            "[BLACKLIST] JSON decode failed:",
            tostring(data)
        )

        return false

    end


    if type(data) ~= "table" then

        warn(
            "[BLACKLIST] Invalid JSON format."
        )

        return false

    end


    table.clear(
        blacklist
    )


    local count = 0


    for _, entry in ipairs(data) do

        if type(entry) == "table"
        and entry.username then

            local username =
                tostring(
                    entry.username
                )


            if username ~= ""
            and username ~= LocalPlayer.Name then

                blacklist[username] = true

                count += 1

            end

        end

    end


    print(
        "[BLACKLIST] Loaded:",
        count,
        "usernames"
    )


    print(
        "[BLACKLIST] Self excluded:",
        LocalPlayer.Name
    )


    return true

end


