--========================================================--
-- REMOVE INVALID LISTINGS
--========================================================--

local function removeInvalidListings()

    print(
        "[REMOVE] Reading booth data..."
    )


    local data =
        getBoothData()


    if not data then

        warn(
            "[REMOVE] Booth data tidak tersedia."
        )


        return

    end


    local playerKey =
        "Player_"
        .. tostring(
            LocalPlayer.UserId
        )


    local playerData =
        data.Players
        and data.Players[playerKey]


    if not playerData then

        warn(
            "[REMOVE] Player booth data tidak ditemukan."
        )


        return

    end


    local listings =
        playerData.Listings


    if not listings then

        print(
            "[REMOVE] Tidak ada listing."
        )


        return

    end


    local items =
        playerData.Items
        or {}


    local checked = 0

    local kept = 0

    local removed = 0


    for listingId, listing in pairs(
        listings
    ) do

        checked += 1


        local item =
            items[listing.ItemId]


        local petType =
            item
            and item.PetType


        local petData =
            item
            and item.PetData


        local baseWeight =
            petData
            and petData.BaseWeight


        local price =
            listing.Price


        local valid =
            matchesTarget(
                petType,
                baseWeight,
                price
            )


        if valid then

            kept += 1


            print(
                string.format(
                    "[KEEP] %s | %.2f KG | PRICE=%s",
                    tostring(petType),
                    tonumber(baseWeight) or 0,
                    tostring(price)
                )
            )

        else

            removed += 1


            print(
                string.format(
                    "[REMOVE] %s | %.2f KG | PRICE=%s",
                    tostring(petType),
                    tonumber(baseWeight) or 0,
                    tostring(price)
                )
            )


            pcall(function()

                RemoveListing:InvokeServer(
                    listingId
                )

            end)


            task.wait(
                REMOVE_DELAY
            )

        end

    end


    print(
        string.format(
            "[REMOVE DONE] Checked=%d | Keep=%d | Removed=%d",
            checked,
            kept,
            removed
        )
    )

end


--========================================================--
-- LIST PET
--========================================================--

local function listPet(
    tool
)

    if not tool
    or not tool.Parent then

        return false

    end


    local uuid =
        tool:GetAttribute(
            "PET_UUID"
        )


    if not uuid then

        warn(
            "[LIST] PET_UUID tidak ditemukan:",
            tool.Name
        )


        return false

    end


    local args = {

        [1] = "Pet",

        [2] = uuid,

        [3] = PRICE

    }


    local success, result =
        pcall(function()

            return CreateListing:InvokeServer(
                unpack(args)
            )

        end)


    if success then

        print(
            string.format(
                "[LISTED] %s | KG=%s | UUID=%s | PRICE=%s",
                tool.Name,
                tostring(
                    getWeight(tool.Name)
                ),
                tostring(uuid),
                tostring(PRICE)
            )
        )


        return true

    else

        warn(
            "[LIST] Failed:",
            tostring(result)
        )


        return false

    end

end


