--========================================================--
-- PERYTON MONITOR
--========================================================--
-- LOOP TETAP:
-- Setiap 10 detik baca ulang kondisi terbaru.
--
-- BLACKLIST:
-- Nama player dicek dari table lokal setiap loop.
-- GitHub TIDAK dibaca ulang.
--========================================================--

local function startPerytonMonitor()

    task.spawn(function()

        while true do

            task.wait(
                PERYTON_CHECK_DELAY
            )


            if isKicked then

                return

            end


            local currentPeryton =
                getPerytonCount()


            local inTradeWorld =
                game.PlaceId == TRADE_WORLD_ID


            print(
                string.format(
                    "[MONITOR] Peryton=%d | World=%s",
                    currentPeryton,
                    inTradeWorld
                    and "TRADE"
                    or "MAIN"
                )
            )


            --================================================--
            -- MAIN WORLD
            --================================================--

            if not inTradeWorld then

                --================================================--
                -- PERYTON ADA
                --================================================--

                if currentPeryton >= MIN_PERYTON then

                    print(
                        "[MONITOR] Main World + Peryton >= "
                        .. tostring(
                            MIN_PERYTON
                        )
                        .. " -> Trade World"
                    )


                    travelToTradeWorld()


                else

                    --================================================--
                    -- PERYTON TIDAK ADA
                    --================================================--

                    local requiredPresent =
                        isRequiredPlayerPresent()


                    if requiredPresent then

                        print(
                            "[MONITOR] Main World + Peryton < "
                            .. tostring(
                                MIN_PERYTON
                            )
                            .. " + "
                            .. REQUIRED_PLAYER
                            .. " ADA -> tunggu."
                        )

                    else

                        warn(
                            "[MONITOR] Main World + Peryton < "
                            .. tostring(
                                MIN_PERYTON
                            )
                            .. " + "
                            .. REQUIRED_PLAYER
                            .. " TIDAK ADA."
                        )


                        kickPlayer(
                            REQUIRED_PLAYER
                            .. " tidak ada di Main World"
                        )


                        return

                    end

                end


            --================================================--
            -- TRADE WORLD
            --================================================--

            else

                --================================================--
                -- BLACKLIST CHECK
                --
                -- HANYA DI TRADE WORLD
                --================================================--

                local badPlayer =
                    isBlacklistedPlayerPresent()


                if badPlayer then

                    warn(
                        "[MONITOR] BLACKLIST DETECTED:",
                        badPlayer
                    )


                    print(
                        "[MONITOR] Blacklist -> SERVER HOP"
                    )


                    teleportToNewTradeServer(
                        "Blacklisted player: "
                        .. tostring(
                            badPlayer
                        )
                    )


                    -- Jangan lanjut logic normal
                    -- pada tick yang sama.
                    continue

                end


                --================================================--
                -- PERYTON CHECK
                --================================================--

                if currentPeryton < MIN_PERYTON then

                    warn(
                        "[MONITOR] Trade World + Peryton < "
                        .. tostring(
                            MIN_PERYTON
                        )
                    )


                    kickPlayer(
                        "Peryton habis di Trade World"
                    )


                    return

                else

                    print(
                        "[MONITOR] Trade World + Peryton >= "
                        .. tostring(
                            MIN_PERYTON
                        )
                        .. " -> tetap."
                    )

                end

            end

        end

    end)

end


