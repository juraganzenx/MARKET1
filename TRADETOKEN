-- ================= CONFIG =================

local TRADE_LOOP_DELAY = 1
local ACCEPT_DELAY = 0.5
local ADD_PET_DELAY = 0.15
local MAX_PETS = 12

local TRADE_TOKENS = 9999


-- Kosong = tidak memasukkan pet.
-- Trade tetap melakukan SetTokens + Accept + Confirm.
local selectedPets = {}


-- ================= SERVICES =================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GuiService = game:GetService("GuiService")
local VirtualInputManager =
    game:GetService("VirtualInputManager")

local player = Players.LocalPlayer

local playerGui =
    player:WaitForChild("PlayerGui")

local backpack =
    player:WaitForChild("Backpack")

local GameEvents =
    ReplicatedStorage:WaitForChild("GameEvents")


-- ==================================================
-- TRADE EVENTS
-- ==================================================

local tradeEvents =
    GameEvents:WaitForChild("TradeEvents")

local addItemEvent =
    tradeEvents:WaitForChild("AddItem")

local setTokensEvent =
    tradeEvents:WaitForChild("SetTokens")

local acceptEvent =
    tradeEvents:WaitForChild("Accept")

local confirmEvent =
    tradeEvents:WaitForChild("Confirm")


-- ==================================================
-- GLOBAL FLAGS
-- ==================================================

local autoAcceptRunning = true


-- ==================================================
-- STATUS GUI
-- ==================================================

local function createStatusGUI()

